# ─────────────────────────────────────────────────────────────────────────────
#  YAHWEH HRMS — Environment Variables Template
#  Copy to .env.local for local development.
#  NEVER commit .env.local to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── DATABASE (Supabase PostgreSQL) ────────────────────────────────────────────
# Supabase project ref: ukmosenqkuczgbirmrgn
# Get your password from: https://supabase.com/dashboard/project/ukmosenqkuczgbirmrgn/settings/database
#
# Option 1 — Transaction Pooler (recommended for serverless / Vercel deployments):
#   Host: aws-0-ap-southeast-2.pooler.supabase.com  Port: 6543
DATABASE_URL="postgresql://postgres.ukmosenqkuczgbirmrgn:[YOUR-DB-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres"
#
# Option 2 — Session Pooler (if using prepared statements):
#   Host: aws-0-ap-southeast-2.pooler.supabase.com  Port: 5432
# DATABASE_URL="postgresql://postgres.ukmosenqkuczgbirmrgn:[YOUR-DB-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"
#
# Option 3 — Direct connection (avoid in Vercel; use only for migrations):
# DATABASE_URL="postgresql://postgres:[YOUR-DB-PASSWORD]@db.ukmosenqkuczgbirmrgn.supabase.co:5432/postgres"

# ── AUTHENTICATION ─────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET="replace-with-secure-random-string-minimum-64-characters-long"
JWT_EXPIRES_IN="8h"

# ── EMAIL (Resend) ─────────────────────────────────────────────────────────
# Get from: https://resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Default from-address for all outbound emails (must be a verified domain in Resend)
RESEND_FROM="HRMS <noreply@yourdomain.com>"

# ── FILE STORAGE (Vercel Blob) ─────────────────────────────────────────────
# Get from: Vercel Dashboard → Storage → Create Blob Store → token auto-generated
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── APP URL ────────────────────────────────────────────────────────────────
# Server-side (email links, OAuth redirects, impersonation)
APP_URL="http://localhost:3000"
# Client-side fallback (MYOB/Xero OAuth callback base URL)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── CRON JOBS ──────────────────────────────────────────────────────────────
# Secret token to authenticate scheduled cron requests.
# Generate with: openssl rand -hex 32
# Set the same value in Vercel Dashboard → Settings → Environment Variables
# AND in Vercel Dashboard → Cron Jobs as the Authorization header secret.
CRON_SECRET="replace-with-output-of-openssl-rand-hex-32"

# ── PAYROLL INTEGRATIONS ────────────────────────────────────────────────────
# MYOB — get from developer.myob.com → My Apps → Register App
MYOB_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MYOB_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Xero — get from developer.xero.com → My Apps → New App
XERO_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
XERO_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── VERCEL API (auto-create tenant projects from super-admin) ───────────────
# Get token: vercel.com/account/tokens → Create Token (Full Account scope)
VERCEL_API_TOKEN="your-vercel-api-token"
# Get team ID: vercel.com/ychrms/settings → Team ID field
VERCEL_TEAM_ID="team_xxxxxxxxxxxxxxxxxxxxxxxx"

# ── MULTI-TENANT ROUTING ───────────────────────────────────────────────────
# NEXT_PUBLIC_TENANT_SLUG identifies which tenant this deployment serves.
# Required by the login page (client component) to auto-select the correct tenant.
# Set per-deployment in Vercel:
#   superadmin project  →  admin
#   yahwehcare project  →  yahweh-care
#   yahwehpc project    →  yahweh-property-care
NEXT_PUBLIC_TENANT_SLUG="admin"

# ROOT_DOMAIN: only needed for subdomain-based routing (optional / future).
# Example: "yahwehcare.com.au"  →  superadmin.yahwehcare.com.au
# Leave blank when using separate Vercel projects (current default setup).
ROOT_DOMAIN=""

# Error Tracking (Sentry)
# Create a project at https://sentry.io, then copy the DSN from Settings > Client Keys
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=yahweh-hrms
SENTRY_AUTH_TOKEN=your-sentry-auth-token
# Environment label shown in Sentry (production | staging | development)
NEXT_PUBLIC_APP_ENV=production
